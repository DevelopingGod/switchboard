    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "ffmpeg-static": "5.3.0",
    "lighthouse": "^13.6.0",
    "sharp": "^0.35.5",
