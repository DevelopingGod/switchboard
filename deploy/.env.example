# Copy to deploy/.env (scripts/setup-wsl.sh does this and fills the generated secrets).
# deploy/.env is gitignored. Never commit real keys.

# --- Pinned versions ---
POSTGRES_VERSION=17.6
LITELLM_VERSION=v1.108.8
PAPERCLIP_VERSION=2026.1106.0

# --- Ports (bound to 127.0.0.1) ---
POSTGRES_PORT=5432
LITELLM_PORT=4000
PAPERCLIP_URL=http://127.0.0.1:3100

# --- Generated secrets (setup-wsl.sh fills these) ---
POSTGRES_USER=switchboard
POSTGRES_PASSWORD=
LITELLM_MASTER_KEY=
# Encrypts provider keys stored in the LiteLLM DB. Never change it after first start.
LITELLM_SALT_KEY=

# --- Local models (Ollama on Windows, reached from Docker) ---
OLLAMA_API_BASE=http://host.docker.internal:11434

# --- Provider API keys (you fill these) ---
GROQ_API_KEY=
GEMINI_API_KEY=
