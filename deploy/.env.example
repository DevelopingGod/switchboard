# Copy to deploy/.env (scripts/setup-wsl.sh does this and fills the generated secrets).
# deploy/.env is gitignored. Never commit real keys.

# --- Pinned versions ---
POSTGRES_VERSION=17.6
LITELLM_VERSION=v1.108.8
PAPERCLIP_VERSION=2026.1106.0

# --- Ports (bound to 127.0.0.1) ---
POSTGRES_PORT=5432
LITELLM_PORT=4000
ROUTER_PORT=8100
HOSTPROBE_PORT=8101
# Paperclip listens on 127.0.0.1:PAPERCLIP_PORT; the router reaches it as host.docker.internal:PAPERCLIP_PORT.
PAPERCLIP_PORT=3100

# --- Generated secrets (setup-wsl.sh fills these) ---
POSTGRES_USER=switchboard
POSTGRES_PASSWORD=
LITELLM_MASTER_KEY=
# Encrypts provider keys stored in the LiteLLM DB. Never change it after first start.
LITELLM_SALT_KEY=
# Router API (M1a). SWITCHBOARD_SECRET_KEY encrypts provider keys in the Router DB (Fernet).
# Back up both *_KEY values (docs/m1a.md); never change them after first start.
SWITCHBOARD_SECRET_KEY=
# Bearer token for Router write/refresh endpoints (PUT/DELETE key, tests, refresh).
ROUTER_ADMIN_TOKEN=
# Shared secret between the router container and hostprobe (WSL).
HOSTPROBE_TOKEN=

# --- Data folder (M2.5, ADR 0016) ---
# Attachments live here: outside the repo, mode 700, shared by the router container (which runs as this uid/gid)
# and hostprobe. setup-wsl.sh fills the ids and creates the folder. Back it up with deploy/.env.
SWITCHBOARD_DATA_DIR=
SWITCHBOARD_UID=
SWITCHBOARD_GID=

# --- Local models (Ollama on Windows, reached from Docker) ---
OLLAMA_API_BASE=http://host.docker.internal:11434

# --- Provider API keys (optional) ---
# Preferred: add keys through the Router API (docs/m1a.md); they are stored encrypted, not here.
# Any key set here is imported once on first router start; after that it may be removed.
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_ZEN_API_KEY=

# --- Paperclip auth (ADR 0007) ---
# Empty for Paperclip's default local_trusted mode (loopback only, no login). Set a board API key here only if
# you switch Paperclip to authenticated mode.
PAPERCLIP_API_KEY=
